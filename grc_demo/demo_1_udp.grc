options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: demo_1_udp
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Public channel over UDP (run on both laptops)
    window_size: (900,650)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
blocks:
- name: go
  id: variable_qtgui_push_button
  parameters:
    comment: ''
    gui_hint: 3,2,1,2
    label: '"Start"'
    pressed: '1'
    released: '0'
    type: int
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
    coordinate:
    - 20
    - 70
    rotation: 0
- name: howto
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: None
    gui_hint: 0,0,1,4
    label: '"How it works"'
    type: string
    value: '"Run this on BOTH laptops: one Sender, one Receiver. Start the Receiver
      first, then press Start on both."'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
    coordinate:
    - 280
    - 70
    rotation: 0
- name: p_loss
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 2,2,1,2
    label: '"Frame loss (Receiver side)"'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.01'
    stop: '0.3'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
    coordinate:
    - 540
    - 70
    rotation: 0
- name: peer
  id: variable_qtgui_entry
  parameters:
    comment: ''
    entry_signal: editingFinished
    gui_hint: 1,2,1,2
    label: '"Other laptop IP:port"'
    type: string
    value: '"127.0.0.1:5006"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
    coordinate:
    - 800
    - 70
    rotation: 0
- name: q_eve
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 2,0,1,2
    label: '"Eavesdropper: share of qubits intercepted"'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.25'
    stop: '1'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
    coordinate:
    - 1060
    - 70
    rotation: 0
- name: qch
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 3,0,1,2
    label: '"Channel disturbance (QBER)"'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.01'
    stop: '0.2'
    value: '0.02'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
    coordinate:
    - 20
    - 180
    rotation: 0
- name: role
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: 1,0,1,2
    label: '"This laptop is"'
    label0: '"Receiver"'
    label1: '"Sender"'
    label2: ''
    label3: ''
    label4: ''
    labels: '[]'
    num_opts: '2'
    option0: '"receiver"'
    option1: '"sender"'
    option2: '2'
    option3: '3'
    option4: '4'
    options: '[0, 1, 2]'
    orient: Qt.QVBoxLayout
    type: string
    value: '"receiver"'
    widget: combo_box
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
    coordinate:
    - 280
    - 180
    rotation: 0
- name: readout
  id: qtgui_number_sink
  parameters:
    affinity: ''
    alias: ''
    autoscale: 'False'
    avg: '0'
    color1: ("black", "black")
    color10: ("black", "black")
    color2: ("black", "black")
    color3: ("black", "black")
    color4: ("black", "black")
    color5: ("black", "black")
    color6: ("black", "black")
    color7: ("black", "black")
    color8: ("black", "black")
    color9: ("black", "black")
    comment: ''
    factor1: '1'
    factor10: '1'
    factor2: '1'
    factor3: '1'
    factor4: '1'
    factor5: '1'
    factor6: '1'
    factor7: '1'
    factor8: '1'
    factor9: '1'
    graph_type: qtgui.NUM_GRAPH_NONE
    gui_hint: 4,0,3,4
    label1: '"Estimated QBER"'
    label10: ''
    label2: '"Secret key"'
    label3: '"Frames sent"'
    label4: '"Frames lost / resent"'
    label5: '"Status (1 running, 2 key, 3 abort)"'
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    max: '100'
    min: '0'
    name: '"Result (same on both laptops when no abort)"'
    nconnections: '5'
    type: float
    unit1: '"%"'
    unit10: ''
    unit2: '"bits"'
    unit3: '""'
    unit4: '""'
    unit5: '""'
    unit6: ''
    unit7: ''
    unit8: ''
    unit9: ''
    update_time: '0.3'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
    coordinate:
    - 320
    - 350
    rotation: 0
- name: udp
  id: epy_block
  parameters:
    _source_code: "import os, sys\nfor _p in (os.getcwd(), os.environ.get(\"QKD_GRC_DIR\"\
      , \"\"), os.path.expanduser(\"~/grc_demo\")):\n    if _p and _p not in sys.path:\
      \ sys.path.insert(0, _p)\nimport qkd_grc\n\nclass blk(qkd_grc.UdpRunner):\n\
      \    \"\"\"Public channel over UDP: BB84 sifting, test subset, verdict and reconciliation\
      \ traffic between two computers.\"\"\"\n    def __init__(self, role=\"sender\"\
      , peer=\"127.0.0.1:5005\", listen=5006, n=40000, qch=0.02, q_eve=0.0, p_loss=0.0,\
      \ go=0):\n        qkd_grc.UdpRunner.__init__(self, role, peer, listen, n, qch,\
      \ q_eve, p_loss, go)\n"
    affinity: ''
    alias: ''
    comment: ''
    go: go
    listen: 5005 if role == 'receiver' else 5006
    maxoutbuf: '0'
    minoutbuf: '0'
    n: '40000'
    p_loss: p_loss
    peer: peer
    q_eve: q_eve
    qch: qch
    role: role
  states:
    _io_cache: '(''UDP public channel (sender)'', ''blk'', [(''role'', "''sender''"),
      (''peer'', "''127.0.0.1:5005''"), (''listen'', ''5006''), (''n'', ''40000''),
      (''qch'', ''0.02''), (''q_eve'', ''0.0''), (''p_loss'', ''0.0''), (''go'', ''0'')],
      [], [(''0'', ''float'', 1), (''1'', ''float'', 1), (''2'', ''float'', 1), (''3'',
      ''float'', 1), (''4'', ''float'', 1)], ''Public channel over UDP: BB84 sifting,
      test subset, verdict and reconciliation traffic between two computers.'', [''go'',
      ''listen'', ''n'', ''p_loss'', ''peer'', ''q_eve'', ''qch'', ''role''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
    coordinate:
    - 20
    - 350
    rotation: 0
connections:
- - udp
  - '0'
  - readout
  - '0'
- - udp
  - '1'
  - readout
  - '1'
- - udp
  - '2'
  - readout
  - '2'
- - udp
  - '3'
  - readout
  - '3'
- - udp
  - '4'
  - readout
  - '4'
metadata:
  file_format: 1
  grc_version: 3.10.9.2
