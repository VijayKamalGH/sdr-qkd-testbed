    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'LIVE 2x2 radio: Receiver (bladeRF RX0 + RX1)'
    window_size: (1250,950)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
