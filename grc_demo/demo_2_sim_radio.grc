- name: sender
  id: epy_block
  parameters:
    _source_code: "import os, sys\nfor _p in (os.getcwd(), os.environ.get(\"QKD_GRC_DIR\"\
      , \"\"), os.path.expanduser(\"~/grc_demo\")):\n    if _p and _p not in sys.path:\
      \ sys.path.insert(0, _p)\nimport qkd_grc\n\nclass blk(qkd_grc.QubitSource):\n\
      \    \"\"\"Sender: builds the frozen frame (pilots, index word, 272 spatial\
      \ qubits) on TX1/TX2. eve_rate = share of qubits an eavesdropper intercepts.\"\
      \"\"\n    def __init__(self, seed=20261030, amplitude=0.14, eve_rate=0.0):\n\
      \        qkd_grc.QubitSource.__init__(self, seed, amplitude, eve_rate)\n"
    affinity: ''
    alias: ''
    amplitude: '0.14'
    comment: ''
    eve_rate: eve_rate
    maxoutbuf: '0'
    minoutbuf: '0'
    seed: '20261030'
  states:
    _io_cache: '(''Qubit source (Sender)'', ''blk'', [(''seed'', ''20261030''), (''amplitude'',
      ''0.14''), (''eve_rate'', ''0.0'')], [], [(''0'', ''complex'', 1), (''1'', ''complex'',
      1)], ''Sender: builds the frozen frame (pilots, index word, 272 spatial qubits)
      on TX1/TX2. eve_rate = share of qubits an eavesdropper intercepts.'', [''amplitude'',
      ''eve_rate'', ''seed''])'
