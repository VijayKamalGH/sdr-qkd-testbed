- name: receiver
  id: epy_block
  parameters:
    _source_code: "import os, sys\nfor _p in (os.getcwd(), os.environ.get(\"QKD_GRC_DIR\"\
      , \"\"), os.path.expanduser(\"~/grc_demo\")):\n    if _p and _p not in sys.path:\
      \ sys.path.insert(0, _p)\nimport qkd_grc\n\nclass blk(qkd_grc.QubitDecoder):\n\
      \    \"\"\"Receiver: sync, channel estimate, MMSE, random-basis measurement,\
      \ sifting, QBER, Cascade, privacy amplification.\"\"\"\n    def __init__(self,\
      \ seed=20261030, receiver_seed=777, batch_frames=40, key_frames=200, skip_first=0,\
      \ reset=0):\n        qkd_grc.QubitDecoder.__init__(self, seed, receiver_seed,\
      \ batch_frames, key_frames, skip_first, reset)\n"
    affinity: ''
    alias: ''
    batch_frames: '40'
    comment: ''
    key_frames: '200'
    maxoutbuf: '0'
    minoutbuf: '0'
    receiver_seed: '777'
    reset: reset
    seed: '20261030'
    skip_first: '0'
  states:
    _io_cache: '(''Qubit decoder (Receiver)'', ''blk'', [(''seed'', ''20261030''),
      (''receiver_seed'', ''777''), (''batch_frames'', ''40''), (''key_frames'', ''200''),
      (''skip_first'', ''0''), (''reset'', ''0'')], [(''0'', ''complex'', 1), (''1'',
      ''complex'', 1)], [(''0'', ''complex'', 1), (''1'', ''float'', 1), (''2'', ''float'',
      1), (''3'', ''float'', 1), (''4'', ''float'', 1), (''5'', ''float'', 1), (''6'',
      ''float'', 1), (''7'', ''float'', 1)], ''Receiver: sync, channel estimate, MMSE,
      random-basis measurement, sifting, QBER, Cascade, privacy amplification.'',
      [''batch_frames'', ''key_frames'', ''receiver_seed'', ''reset'', ''seed'', ''skip_first''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
    coordinate:
    - 1820
    - 720
    rotation: 0
