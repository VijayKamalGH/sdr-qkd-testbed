- name: sender
  id: epy_block
  parameters:
    _source_code: "import os, sys\nfor _p in (os.getcwd(), os.environ.get(\"QKD_GRC_DIR\"\
      , \"\"), os.path.expanduser(\"~/grc_demo\")):\n    if _p and _p not in sys.path:\
      \ sys.path.insert(0, _p)\nimport qkd_grc\n\nclass blk(qkd_grc.MessageSource):\n\
      \    \"\"\"Sender: splits the text into 30-byte chunks (+CRC32), one chunk per\
      \ 48 ms frame, Z basis (bit 0 on TX1, bit 1 on TX2), and repeats the message\
      \ in a loop.\"\"\"\n    def __init__(self, text=\"hello\", amplitude=0.14, send=0):\n\
      \        qkd_grc.MessageSource.__init__(self, text, amplitude, send)\n"
    affinity: ''
    alias: ''
    amplitude: '0.14'
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    send: send
    text: msg
  states:
    _io_cache: '(''Message source (Sender)'', ''blk'', [(''text'', "''hello''"), (''amplitude'',
      ''0.14''), (''send'', ''0'')], [], [(''0'', ''complex'', 1), (''1'', ''complex'',
      1)], ''Sender: splits the text into 30-byte chunks (+CRC32), one chunk per 48
      ms frame, Z basis (bit 0 on TX1, bit 1 on TX2), and repeats the message in a
      loop.'', [''amplitude'', ''send'', ''text''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
    coordinate:
    - 20
    - 850
    rotation: 0
- name: show_text
  id: snippet
  parameters:
    alias: ''
    code: "from PyQt5 import Qt\n_lab = Qt.QLabel(\"(waiting for a message)\")\n_lab.setWordWrap(True)\n\
      _lab.setAlignment(Qt.Qt.AlignCenter)\n_lab.setMinimumHeight(70)\n_lab.setStyleSheet(\"\
      font-size: 22px; font-weight: bold; padding: 8px; border: 2px solid #888; border-radius:\
      \ 6px;\")\nself.top_grid_layout.addWidget(_lab, 4, 0, 1, 4)\ndef _upd():\n \
      \   d = self.receiver\n    st = int(d.vals[4])\n    txt = d.shown if st == 2\
      \ else (\"receiving: %d good chunk(s) so far ...\" % int(d.vals[1]) if st ==\
      \ 1 else \"(waiting for a message)\")\n    _lab.setText(\"Received: \" + txt\
      \ if st == 2 else txt)\n    _lab.setStyleSheet(\"font-size: 22px; font-weight:\
      \ bold; padding: 8px; border-radius: 6px; border: 2px solid %s;\" % (\"#2a9d3a\"\
      \ if st == 2 else \"#c88a00\" if st == 1 else \"#888\"))\ntry:             \
      \                     # \"Send again\" also takes the text typed in the box\
      \ (no Enter needed)\n    _le = self._msg_line_edit\n    for _b in self.findChildren(Qt.QPushButton):\n\
      \        if _b.text() == \"Send again\":\n            _b.pressed.connect(lambda:\
      \ self.set_msg(str(_le.text())))\nexcept Exception as _e:\n    print(\"note:\
      \ could not link the Send button to the message box:\", _e)\n_tm = Qt.QTimer()\n\
      _tm.timeout.connect(_upd)\n_tm.start(250)\nself._msg_timer = _tm\n"
