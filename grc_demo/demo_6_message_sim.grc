options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: demo_6_message_sim
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Send a text message over the simulated 2x2 radio
    window_size: (1250,950)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
blocks:
- name: cfo
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 2,2,1,2
    label: '"Carrier offset between radios (Hz)"'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-2000'
    step: '50'
    stop: '2000'
    value: '500'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
    coordinate:
    - 20
    - 70
    rotation: 0
- name: h01
  id: variable
  parameters:
    comment: ''
    value: mix*np.exp(1j*np.deg2rad(phase))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
    coordinate:
    - 280
    - 70
    rotation: 0
- name: h10
  id: variable
  parameters:
    comment: ''
    value: 0.85*mix*np.exp(1j*np.deg2rad(phase+70))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
    coordinate:
    - 540
    - 70
    rotation: 0
- name: h11
  id: variable
  parameters:
    comment: ''
    value: 0.9*np.exp(0.7j)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
    coordinate:
    - 800
    - 70
    rotation: 0
- name: howto
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: None
    gui_hint: 0,0,1,4
    label: '"How it works"'
    type: string
    value: '"Type a message, press Enter. Sender: 30-byte chunks + CRC per 48 ms frame
      -> 2x2 channel + noise -> Receiver checks every CRC and rebuilds the text."'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
    coordinate:
    - 1060
    - 70
    rotation: 0
