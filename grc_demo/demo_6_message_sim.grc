- name: receiver
  id: epy_block
  parameters:
    _source_code: "import os, sys\nfor _p in (os.getcwd(), os.environ.get(\"QKD_GRC_DIR\"\
      , \"\"), os.path.expanduser(\"~/grc_demo\")):\n    if _p and _p not in sys.path:\
      \ sys.path.insert(0, _p)\nimport qkd_grc\n\nclass blk(qkd_grc.MessageDecoder):\n\
      \    \"\"\"Receiver: pilot sync, channel estimate, MMSE, then CRC check per\
      \ chunk; the first good copy of every chunk is kept and the text is assembled.\"\
      \"\"\n    def __init__(self, batch_frames=3, skip_first=0, reset=0, detector=\"\
      MMSE\", threaded=0):\n        qkd_grc.MessageDecoder.__init__(self, batch_frames,\
      \ skip_first, reset, detector, False, threaded)\n"
    affinity: ''
    alias: ''
    batch_frames: '3'
    comment: ''
    detector: '"MMSE"'
    maxoutbuf: '0'
    minoutbuf: '0'
    reset: reset
    skip_first: '0'
    threaded: '0'
  states:
    _io_cache: '(''Qubit decoder (Receiver)'', ''blk'', [(''batch_frames'', ''3''),
      (''skip_first'', ''0''), (''reset'', ''0''), (''detector'', "''MMSE''"), (''threaded'',
      ''0'')], [(''0'', ''complex'', 1), (''1'', ''complex'', 1)], [(''0'', ''complex'',
      1), (''1'', ''float'', 1), (''2'', ''float'', 1), (''3'', ''float'', 1), (''4'',
      ''float'', 1), (''5'', ''float'', 1), (''6'', ''float'', 1), (''7'', ''float'',
      1)], ''Receiver: pilot sync, channel estimate, MMSE, then CRC check per chunk;
      the first good copy of every chunk is kept and the text is assembled.'', [''batch_frames'',
      ''detector'', ''reset'', ''skip_first'', ''threaded''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
    coordinate:
    - 1820
    - 720
    rotation: 0
