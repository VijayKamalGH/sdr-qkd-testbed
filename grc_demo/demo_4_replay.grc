- name: receiver
  id: epy_block
  parameters:
    _source_code: "import os, sys\nfor _p in (os.getcwd(), os.environ.get(\"QKD_GRC_DIR\"\
      , \"\"), os.path.expanduser(\"~/grc_demo\")):\n    if _p and _p not in sys.path:\
      \ sys.path.insert(0, _p)\nimport qkd_grc\n\nclass blk(qkd_grc.QubitDecoder):\n\
      \    \"\"\"Receiver: sync, channel estimate, MMSE or ZF, random-basis measurement,\
      \ sifting, QBER, Cascade, privacy amplification.\"\"\"\n    def __init__(self,\
      \ seed=20261030, receiver_seed=777, batch_frames=40, key_frames=200, skip_first=0,\
      \ reset=0, detector=\"MMSE\"):\n        qkd_grc.QubitDecoder.__init__(self,\
      \ seed, receiver_seed, batch_frames, key_frames, skip_first, reset, detector)\n"
    affinity: ''
    alias: ''
    batch_frames: '40'
    comment: ''
    detector: det
    key_frames: '250'
    maxoutbuf: '0'
    minoutbuf: '0'
    receiver_seed: '777'
    reset: reset
    seed: '20261030'
    skip_first: '200000'
  states:
    _io_cache: '(''Qubit decoder (Receiver)'', ''blk'', [(''seed'', ''20261030''),
      (''receiver_seed'', ''777''), (''batch_frames'', ''40''), (''key_frames'', ''200''),
      (''skip_first'', ''0''), (''reset'', ''0''), (''detector'', "''MMSE''")], [(''0'',
      ''complex'', 1), (''1'', ''complex'', 1)], [(''0'', ''complex'', 1), (''1'',
      ''float'', 1), (''2'', ''float'', 1), (''3'', ''float'', 1), (''4'', ''float'',
      1), (''5'', ''float'', 1), (''6'', ''float'', 1), (''7'', ''float'', 1)], ''Receiver:
      sync, channel estimate, MMSE or ZF, random-basis measurement, sifting, QBER,
      Cascade, privacy amplification.'', [''batch_frames'', ''detector'', ''key_frames'',
      ''receiver_seed'', ''reset'', ''seed'', ''skip_first''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
    coordinate:
    - 320
    - 610
    rotation: 0
- name: replay
  id: epy_block
  parameters:
    _source_code: "import os, sys\nfor _p in (os.getcwd(), os.environ.get(\"QKD_GRC_DIR\"\
      , \"\"), os.path.expanduser(\"~/grc_demo\")):\n    if _p and _p not in sys.path:\
      \ sys.path.insert(0, _p)\nimport qkd_grc\n\nclass blk(qkd_grc.CaptureReplay):\n\
      \    \"\"\"Plays two stored capture files (RX0, RX1) in a loop; a missing file\
      \ only prints a message.\"\"\"\n    def __init__(self, rx0_file=\"H194E_V18Z34_SWW203_ON_RX0.c64\"\
      , rx1_file=\"H194E_V18Z34_SWW203_ON_RX1.c64\"):\n        qkd_grc.CaptureReplay.__init__(self,\
      \ rx0_file, rx1_file)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    rx0_file: rx0_file
    rx1_file: rx1_file
  states:
    _io_cache: ('Capture replay', 'blk', [('rx0_file', "'H194E_V18Z34_SWW203_ON_RX0.c64'"),
      ('rx1_file', "'H194E_V18Z34_SWW203_ON_RX1.c64'")], [], [('0', 'complex', 1),
      ('1', 'complex', 1)], 'Plays two stored capture files (RX0, RX1) in a loop;
      a missing file only prints a message.', ['rx0_file', 'rx1_file'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
    coordinate:
    - 20
    - 350
    rotation: 0
