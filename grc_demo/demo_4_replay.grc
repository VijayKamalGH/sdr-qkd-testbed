options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: demo_4_replay
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Decode a stored REAL 2x2 radio capture
    window_size: (1250,950)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
blocks:
- name: det
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: 2,0,1,2
    label: '"Detector"'
    label0: '"MMSE"'
    label1: '"ZF (zero forcing)"'
    label2: ''
    label3: ''
    label4: ''
    labels: '[]'
    num_opts: '2'
    option0: '"MMSE"'
    option1: '"ZF"'
    option2: '2'
    option3: '3'
    option4: '4'
    options: '[0, 1, 2]'
    orient: Qt.QVBoxLayout
    type: string
    value: '"MMSE"'
    widget: combo_box
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
    coordinate:
    - 20
    - 70
    rotation: 0
- name: howto
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: None
    gui_hint: 0,0,1,4
    label: '"How it works"'
    type: string
    value: '"Plays a recorded capture of the real radio link (two files) through the
      Receiver. Put the .c64 files in this folder."'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
    coordinate:
    - 280
    - 70
    rotation: 0
- name: reset
  id: variable_qtgui_push_button
  parameters:
    comment: ''
    gui_hint: 2,2,1,2
    label: '"New session"'
    pressed: '1'
    released: '0'
    type: int
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
    coordinate:
    - 540
    - 70
    rotation: 0
- name: rx0_file
  id: variable_qtgui_entry
